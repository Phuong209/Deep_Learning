   "source": [
    "#Bài 5 — Reshape và Flatten\n",
    "import torch\n",
    "a = torch.randn(3, 4)\n",
    "print(\"Original:\")\n",
    "print(a)\n",
    "print(\"\\nFlatten:\")\n",
    "print(a.ravel())\n",
    "print(\"\\nReshape to 3 x 2 x 2:\")\n",
    "print(a.reshape(3, 2, 2))"
   ]
  }
