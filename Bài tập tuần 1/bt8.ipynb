   "source": [
    "#Bài 8 — Autograd cơ bản\n",
    "import torch\n",
    "x = torch.tensor(\n",
    "3.6,\n",
    "requires_grad=True\n",
    ")\n",
    "y = x * x\n",
    "y.backward()\n",
    "print(\"x =\", x)\n",
    "print(\"y =\", y)\n",
    "print(\"x.grad =\", x.grad)"
   ]
  }
