    "#Bài 6 — Phép toán và nhân ma trận\n",
    "import torch\n",
    "a = torch.randn(2, 3)\n",
    "b = torch.randn(2, 3)\n",
    "print(\"a:\")\n",
    "print(a)\n",
    "print(\"b:\")\n",
    "print(b)\n",
    "\n",
    "\n",
    "print(\"\\na + b:\")\n",
    "print(a + b)\n",
    "print(\"\\na / b:\")\n",
    "print(a / b)\n",
    "print(\"\\na^2:\")\n",
    "print(a ** 2)\n",
    "print(\"\\nMatrix multiplication:\")\n",
    "print(a @ b.T)"
   ]
