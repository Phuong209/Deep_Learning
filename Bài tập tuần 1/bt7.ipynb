    "#Bài 7 — Các hàm thống kê\n",
    "import torch\n",
    "a = torch.randn(3, 4)\n",
    "print(a)\n",
    "print(\"\\nMean:\")\n",
    "print(torch.mean(a, dim=0))\n",
    "print(\"\\nStandard deviation:\")\n",
    "print(torch.std(a, dim=0))\n",
    "print(\"\\nCumulative sum:\")\n",
    "print(torch.cumsum(a, dim=0))\n"
   ]
  }
